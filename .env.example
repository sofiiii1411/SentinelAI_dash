# ========================================================
# SentinelAI-X Security Portal - SMTP Email Configuration
# ========================================================

# 1. GMAIL SMTP SETUP (Recommended):
# - Go to your Google Account (Security -> 2-Step Verification)
# - Generate an App Password at: https://myaccount.google.com/apppasswords
# - Select 'Mail' / 'Custom' and copy the 16-character password generated.
# - Fill in the credentials below:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.sentinelai.system@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM=SentinelAI-X Security <your.sentinelai.system@gmail.com>

# 2. ALTERNATIVE SMTP PROVIDERS (e.g. Brevo, SendGrid, Mailgun):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_login
# SMTP_PASS=your_smtp_key
