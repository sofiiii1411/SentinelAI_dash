# ========================================================
# SentinelAI-X Flask Backend - Python SMTP Email Configuration
# ========================================================

# Server Port
PORT=5000

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# --------------------------------------------------------
# HOW TO GET A GMAIL 16-CHARACTER APP PASSWORD:
# 1. Go to your Google Account -> Security -> 2-Step Verification (turn ON).
# 2. Visit: https://myaccount.google.com/apppasswords
# 3. Create an app named "SentinelAI-X".
# 4. Copy the 16-character password (e.g. "abcd efgh ijkl mnop") into SMTP_PASSWORD.
# --------------------------------------------------------
